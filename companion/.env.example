# Copy to .env locally. Never commit real credentials or model files.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_EFFORT=low
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_TTS_MODEL=glm-tts
GLM_TTS_VOICE=tongtong
GLM_ASR_MODEL=glm-asr
ASR_ENGINE=local
TTS_ENGINE=local
# Replace with your local model directory; keep models outside version control.
MODELS_DIR=./models
PORT=8765

# World Studio: backend only. Existing DeepSeek settings are the default planner.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
RODIN_API_KEY=
TRIPO_API_KEY=
TRIPO_PROXY_URL=
# Optional independent planner model/account:
SCENE_PLANNER_API_KEY=
SCENE_PLANNER_BASE_URL=
SCENE_PLANNER_MODEL=
