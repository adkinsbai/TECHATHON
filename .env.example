# Copy this file to .env. Never put the key in a VITE_ variable.
RODIN_API_KEY=
TRIPO_API_KEY=
# Optional: reuse your existing HTTP CONNECT proxy for Tripo only, e.g. http://127.0.0.1:7890
TRIPO_PROXY_URL=
OPENAI_API_KEY=
# OpenAI-compatible relay: set its /v1 API URL here. Never put a login token URL here.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
PORT=5173
# Optional Blender 4.5 LTS executable. Project-local portable Blender is auto-detected.
# BLENDER_PATH=C:/Program Files/Blender Foundation/Blender 4.5/blender.exe
